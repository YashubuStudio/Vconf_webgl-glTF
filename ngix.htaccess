server {
  listen 443 ssl http2;
  server_name 2025system.vconf.org;

  # ドキュメントルート（コントロールパネル表記に合わせる）
  root /home/c7822687/public_html/2025system.vconf.org;

  # 同一オリジンCORS
  set $allowed_origin "https://2025system.vconf.org";

  # ============================
  # /api/ping.php （GET/OPTIONS）
  # ============================
  location = /api/ping.php {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin $allowed_origin always;
      add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Content-Type" always;
      return 204;
    }
    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    add_header Content-Type "application/json; charset=utf-8" always;

    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    # ← 実環境に合わせて選択
    fastcgi_pass unix:/run/php/php-fpm.sock;
    # fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    # fastcgi_pass 127.0.0.1:9000;
  }

  # =====================================================
  # /api/(upload|regenerate).php （POST/OPTIONS・アップロード）
  # =====================================================
  location ~ ^/api/(upload|regenerate)\.php$ {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin $allowed_origin always;
      add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
      add_header Access-Control-Allow-Headers "Content-Type" always;
      return 204;
    }
    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    add_header Content-Type "application/json; charset=utf-8" always;

    client_max_body_size 100m;  # nginx側のアップロード上限
    fastcgi_param PHP_VALUE "upload_max_filesize=100M
post_max_size=100M
max_execution_time=300
max_input_time=300";

    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass unix:/run/php/php-fpm.sock;  # ← 実環境に合わせる
  }

  # ===============================================
  # /api/uploads/：実行ファイルのアクセスは明示的に拒否
  #   （正規表現ロケーションは通常ロケーションより優先）
  # ===============================================
  location ~ ^/api/uploads/.*\.(php[0-9]?|phtml|phar|pl|cgi|sh|py|rb|jsp|asp|aspx)$ {
    return 403;
  }
  location ~ ^/api/uploads/(?:\.|.*\.(?:env|ini|config|bak|swp|git|hg|txt))$ {
    return 403;
  }

  # ===============================================
  # /api/uploads/：静的公開 + 一覧 + CORS + キャッシュ
  # ===============================================
  location /api/uploads/ {
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    add_header X-Content-Type-Options "nosniff" always;

    if ($request_method = OPTIONS) { return 204; }

    # 任意のキャッシュ最適化
    location ~ \.(png|glb|gltf|zip)$ {
      expires 30d;
      add_header Cache-Control "public, max-age=2592000, immutable" always;
    }
  }

  # ===============================================
  # /api のその他は403（CORSヘッダは付与）
  # ===============================================
  location ~ ^/api/ {
    add_header Access-Control-Allow-Origin $allowed_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;
    if ($request_method = OPTIONS) { return 204; }
    return 403;
  }

  # ===============================================
  # React ルーティング：/api は除外したうえで index.html へ
  # ===============================================
  location / {
    try_files $uri $uri/ /index.html;
  }

  # （ssl_certificate / ssl_certificate_key 等は環境に合わせて）
}
