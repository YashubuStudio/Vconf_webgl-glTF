# ===== すべてのプリフライト(OPTIONS)は 204 即返し =====
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} =OPTIONS
  RewriteRule ^ - [R=204,L]
</IfModule>

# ===== /api/ping.php を許可（GET/OPTIONS + CORS + JSON）=====
<If "%{REQUEST_URI} =~ m#^/api/ping\.php$#">
  Require all granted
  <IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://2025system.vconf.org"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
    Header set Content-Type "application/json; charset=utf-8"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
  </IfModule>
</If>

# ===== /api/(upload|regenerate).php を許可（POST/OPTIONS + CORS）=====
<If "%{REQUEST_URI} =~ m#^/api/(upload|regenerate)\.php$#">
  Require all granted
  <IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://2025system.vconf.org"
    Header always set Access-Control-Allow-Methods "POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
    Header set Content-Type "application/json; charset=utf-8"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
  </IfModule>

  # PHPのアップロード/実行タイムアウトを緩和（必要分のみ）
  php_value upload_max_filesize 100M
  php_value post_max_size 100M
  php_value max_execution_time 300
  php_value max_input_time 300
</If>

# ===== /api のその他は非公開（403 だが CORSは付与）=====
<If "%{REQUEST_URI} =~ m#^/api/(?!uploads/|ping\.php$|upload\.php$|regenerate\.php$)#">
  Require all denied
  <IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://2025system.vconf.org"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</If>
